sort=-time
layer=overlay
anchor=top-right
width=340
height=140
margin=14
padding=16
font=Geist 11

# Match the waybar dynamic island: dimmed translucent edge instead of a hard
# stroke, soft 16px radius, rounded icon corners.
border-size=2
border-radius=16
icon-border-radius=8

background-color=#1e1e2eE0
text-color=#cdd6f4
border-color=#cba6f788
progress-color=over #89b4fa

icons=1
max-icon-size=56
format=<b>%s</b>\n%b
default-timeout=5000
ignore-timeout=1

[urgency=low]
text-color=#a6adc8
background-color=#1e1e2e99
border-color=#6c708666

[urgency=high]
border-color=#fab387CC
background-color=#1e1e2eF0
progress-color=over #fab387
default-timeout=0

[summary~="log-.*"]
invisible=1

# Screenshot previews: bigger thumbnail, honor the 6s timeout (the global
# ignore-timeout=1 would otherwise pin the toast open forever).
[app-name="Screenshot"]
width=420
height=280
max-icon-size=200
icon-border-radius=12
default-timeout=6000
ignore-timeout=0
