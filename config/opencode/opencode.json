{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "9router": {
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://9router.dreadwrym.my.id/v1",
        "apiKey": "{file:~/.secret/9router-api-key}"
      },
      "models": {
        "dr/deeprelay/deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash",
          "modelID": "dr/deeprelay/deepseek-v4.1-flash",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": true,
              "toggle": true,
              "effort": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ]
            }
          },
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        },
        "dr/deeprelay/kimi-k3": {
          "name": "Kimi K3",
          "modelID": "dr/deeprelay/kimi-k3",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": true,
              "toggle": false,
              "effort": [
                "low",
                "medium",
                "high",
                "max"
              ]
            }
          },
          "limit": {
            "context": 1048576,
            "output": 131072
          }
        },
        "dr/deeprelay/glm-5.3": {
          "name": "GLM 5.3",
          "modelID": "dr/deeprelay/glm-5.3",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": true,
              "toggle": false,
              "effort": [
                "thinking"
              ]
            }
          },
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "dr/deeprelay/glm-5.3-flash": {
          "name": "GLM 5.3 Flash",
          "modelID": "dr/deeprelay/glm-5.3-flash",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": true,
              "toggle": false,
              "effort": [
                "thinking"
              ]
            }
          },
          "limit": {
            "context": 1000000,
            "output": 131072
          }
        }
      }
    }
  },
  "plugins": [
    "@dietrichgebert/ponytail",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--headless",
          "--browser=chromium"
        ]
      },
      "context7": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@upstash/context7-mcp"
        ]
      },
      "penpot": {
        "type": "remote",
        "url": "https://penpot.dreadwrym.my.id/mcp/stream?userToken={file:~/.secret/penpot-user-token}",
        "headers": {
          "CF-Access-Client-Id": "{file:~/.secret/penpot-cf-access-client-id}",
          "CF-Access-Client-Secret": "{file:~/.secret/penpot-cf-access-client-secret}"
        }
      }
    }
  }
}
