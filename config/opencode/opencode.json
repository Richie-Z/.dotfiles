{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "mcp": {
    "servers": {
      "context7": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@upstash/context7-mcp"
        ],
        "environment": {
          "CONTEXT7_API_KEY": "{file:~/.secret/context7-api-key}"
        }
      }
    }
  },
  "providers": {
    "9router": {
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://9router.dreadwrym.my.id/v1",
        "apiKey": "{file:~/.secret/9router-api-key}"
      },
      "models": {
        "FUCKING-FREE": {
          "name": "FUCKING FREE (Combo)",
          "modelID": "FUCKING-FREE",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": true,
              "toggle": true
            }
          },
          "limit": {
            "context": 128000,
            "output": 32000
          }
        },
        "deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash 1017 (Combo)",
          "modelID": "deepseek-v4.1-flash",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": true,
              "toggle": true,
              "effort": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ]
            }
          },
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        },
        "GLM5.3-Flash": {
          "name": "GLM 5.3 Flash (Combo)",
          "modelID": "GLM5.3-Flash",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": true,
              "toggle": false,
              "effort": [
                "thinking"
              ]
            }
          },
          "limit": {
            "context": 1000000,
            "output": 131072
          }
        },
        "qwen4-max": {
          "name": "Qwen4 Max (Combo)",
          "modelID": "qwen4-max",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": true,
              "toggle": true
            }
          },
          "limit": {
            "context": 1000000,
            "output": 65536
          }
        }
      }
    }
  },
}
