@import "catppuccin-mocha"

* {
    background-color: transparent;
    text-color:       @text;
    shade-bg:         white / 12%;
    shade-shadow:     white / 6%;

    /* alpha variants — rofi can't do "@var / 92%", hex8 only */
    win-bg:     #1e1e2ee6; /* base      @ 0.90 */
    surf:       #31324499; /* surface0  @ 0.60 */
    surf-sel:   #313244bf; /* surface0  @ 0.75 */
    line:       #6c708673; /* overlay0  @ 0.45 */
    accent-line: #cba6f78c; /* mauve    @ 0.55 */
}

/* Floating centered window — chrome matches waybar/wlogout */
window {
    width:           640px;
    padding:         12px;
    border:          1px solid;
    border-color:    @line;
    border-radius:   16px;
    background-color: @win-bg;
    transparency:    "real";
    cursor:          "default";
}

mainbox {
    spacing: 12px;
    padding: 4px;
}

inputbar {
    children:        [ "prompt", "entry" ];
    spacing:         10px;
    padding:         10px 16px;
    border:          1px solid;
    border-color:    @line;
    border-radius:   999px;
    background-color: @surf;
    text-color:      @subtext1;
}

prompt {
    background-color: transparent;
    text-color:       inherit;
}

entry {
    background-color:  transparent;
    text-color:        inherit;
    cursor:            inherit;
    placeholder:       "Search";
    placeholder-color: @overlay0;
}

listview {
    lines:        6;
    columns:      1;
    spacing:      4px;
    dynamic:      true;
    scrollbar:    false;
    fixed-height: false;
    text-color:   @subtext1;
}

element {
    padding:       8px 12px;
    spacing:       10px;
    border-radius: 10px;
    cursor:        pointer;
    text-color:    @subtext1;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @subtext1;
}

element selected.normal {
    background-color: @surf-sel;
    border:          1px solid;
    border-color:    @accent-line;
    text-color:      @text;
}

element-icon {
    size:            24px;
    background-color: transparent;
    cursor:          inherit;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
    horizontal-align: 0;
}

mode-switcher {
    spacing: 8px;
}

button {
    padding:          8px 14px;
    border-radius:    999px;
    background-color: @surf;
    text-color:       @subtext0;
    cursor:           pointer;
}

button selected {
    background-color: @surface0;
    border:          1px solid;
    border-color:    @accent-line;
    text-color:      @text;
}

message {
    padding:          12px 16px;
    border-radius:    10px;
    background-color: @surf;
}

textbox {
    background-color: transparent;
    text-color:       @subtext1;
    highlight:        none;
}
