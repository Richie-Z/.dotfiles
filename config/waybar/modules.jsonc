{
  "custom/arch": {
    "format": "󰣇",
    "tooltip": true,
    "tooltip-format": "btw"
  },
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "warp-on-scroll": false,
    "format": "{name}"
  },
  "custom/media": {
    "exec": "playerctl metadata --format '{{artist}} - {{title}}' 2>/dev/null | cut -c 1-44",
    "interval": 2,
    "format": "<span foreground='#f5c2e7'>󰎌</span> {}",
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰛐",
      "deactivated": "󰛓"
    }
  },
  "pulseaudio": {
    "format": "<span foreground='#94e2d5'>{icon}</span> {volume}%",
    "format-bluetooth": "<span foreground='#94e2d5'>{icon}</span> {volume}%",
    "format-bluetooth-muted": "<span foreground='#6c7086'>{icon}</span>",
    "format-muted": "<span foreground='#6c7086'>󰖁</span>",
    "format-source": "󰍬 {volume}%",
    "format-source-muted": "󰍭",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰋎",
      "headset": "󰋎",
      "phone": "󰹞",
      "portable": "󰹞",
      "car": "󰄝",
      "bluetooth": "󰂯",
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "on-click": "pwvucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
    "scroll-step": 1,
    "smooth-scrolling-threshold": 1,
    "tooltip": true,
    "tooltip-format": "{desc}",
    "on-update": "echo",
    "states": {
      "warning": 90,
      "critical": 100
    }
  },
  "network": {
    "format-wifi": "<span foreground='#74c7ec'>󰖩</span> {signalStrength}%",
    "format-ethernet": "<span foreground='#74c7ec'>󰈀</span> {ipaddr}/{cidr}",
    "tooltip-format": "{ifname} via {gwaddr} 󰈀",
    "format-linked": "<span foreground='#f9e2af'>󰈀</span> {ifname} (No IP)",
    "format-disconnected": "<span foreground='#f38ba8'>󰤭</span>",
    "on-click": "sh ~/scripts/rofi-wifi-menu/rofi-wifi-menu.sh"
  },
  "battery": {
    "states": {
      "warning": 20,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-full": "{icon} {capacity}%",
    "format-charging": "󰂉 {capacity}%",
    "format-plugged": "󰚆 {capacity}%",
    "format-alt": "{time} {icon}",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ]
  },
  "clock": {
    "format": "<span foreground='#cba6f7'>󰅐</span> {:%H:%M}",
    "format-alt": "<span foreground='#cba6f7'>󰃭</span> {:%d-%m-%Y}",
    "tooltip-format": "<big>{:%A, %d %B %Y}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "custom/power": {
    "format": "󰐥",
    "on-click": "wlogout",
    "interval": 86400,
    "tooltip": false
  }
}
